{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2026-09-06T00:00:00.000Z",
  "__export_source": "insomnia.desktop.app",
  "resources": [
    {
      "_id": "wrk_identity",
      "_type": "workspace",
      "name": "identity-service",
      "description": "Hospital identity-service — login, refresh (rotation), ADMIN-only registration, profile lookup, and error cases. Tokens chain automatically: just run 'POST /auth/login (admin)' once, everything else pulls from it.",
      "scope": "collection"
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_identity",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:8080",
        "admin_email": "admin@hospital.local",
        "admin_password": "admin12345",
        "user_id": ""
      },
      "dataPropertyOrder": {
        "&": ["base_url", "admin_email", "admin_password", "user_id"]
      },
      "metaSortKey": 1
    },

    { "_id": "fld_auth", "_type": "request_group", "parentId": "wrk_identity", "name": "1 · auth", "metaSortKey": 1 },
    { "_id": "fld_users", "_type": "request_group", "parentId": "wrk_identity", "name": "2 · users (admin)", "metaSortKey": 2 },
    { "_id": "fld_errors", "_type": "request_group", "parentId": "wrk_identity", "name": "3 · error cases", "metaSortKey": 3 },

    {
      "_id": "req_login_admin",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/login  (admin)  → 200",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.admin_email }}\",\n  \"password\": \"{{ _.admin_password }}\"\n}"
      },
      "description": "Run this first. Response: { accessToken, refreshToken, tokenType: Bearer, expiresIn: 3600 }. Every other request reads its tokens from this response automatically.",
      "metaSortKey": 1
    },
    {
      "_id": "req_refresh",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/refresh  → 200 (new pair)",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/refresh",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refreshToken\": \"{% response 'body', 'req_login_admin', 'b64::JC5yZWZyZXNoVG9rZW4=::46b', 'when-expired', 3000 %}\"\n}"
      },
      "description": "Exchanges the login refresh token for a new pair. The presented token is revoked (rotation).",
      "metaSortKey": 2
    },
    {
      "_id": "req_refresh_reuse",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/refresh  (reuse the same token) → 401",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/refresh",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refreshToken\": \"{% response 'body', 'req_login_admin', 'b64::JC5yZWZyZXNoVG9rZW4=::46b', 'when-expired', 3000 %}\"\n}"
      },
      "description": "Run right after 'POST /auth/refresh'. Same (now revoked) token → 401. Proves single-use rotation.",
      "metaSortKey": 3
    },
    {
      "_id": "req_login_wrong",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/login  (wrong password) → 401",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.admin_email }}\",\n  \"password\": \"wrong-password\"\n}"
      },
      "description": "Generic 'Invalid credentials' — same response as an unknown email.",
      "metaSortKey": 4
    },
    {
      "_id": "req_login_doctor",
      "_type": "request",
      "parentId": "fld_auth",
      "name": "POST /auth/login  (the registered doctor) → 200",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"doc@hospital.local\",\n  \"password\": \"secret12345\"\n}"
      },
      "description": "Run AFTER '2 · users (admin) → POST /users (register DOCTOR)'. Its token is used by the 403 test.",
      "metaSortKey": 5
    },

    {
      "_id": "req_register_doctor",
      "_type": "request",
      "parentId": "fld_users",
      "name": "POST /users  (register DOCTOR) → 201",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_admin', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"doc@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"DOCTOR\",\n  \"fullName\": \"Dr House\",\n  \"crm\": \"CRM-1\",\n  \"specialty\": \"Diagnostics\"\n}"
      },
      "description": "Response: { id, email, role, fullName }. 'GET /users/{id}' reads the id from here.",
      "metaSortKey": 1
    },
    {
      "_id": "req_register_nurse",
      "_type": "request",
      "parentId": "fld_users",
      "name": "POST /users  (register NURSE) → 201",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_admin', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"nurse@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"NURSE\",\n  \"fullName\": \"Nurse Joy\"\n}"
      },
      "metaSortKey": 2
    },
    {
      "_id": "req_register_patient",
      "_type": "request",
      "parentId": "fld_users",
      "name": "POST /users  (register PATIENT) → 201",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_admin', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"pat@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"PATIENT\",\n  \"fullName\": \"John Doe\"\n}"
      },
      "description": "For a PATIENT the access token later carries patientId = sub.",
      "metaSortKey": 3
    },
    {
      "_id": "req_get_user",
      "_type": "request",
      "parentId": "fld_users",
      "name": "GET /users/{id}  (chained) → 200",
      "method": "GET",
      "url": "{{ _.base_url }}/users/{% response 'body', 'req_register_doctor', 'b64::JC5pZA==::46b', 'when-expired', 600 %}",
      "headers": [],
      "description": "Public route (used by notification/history). Response: { id, name, email, role } — 'name' is the fullName.",
      "metaSortKey": 4
    },
    {
      "_id": "req_get_user_manual",
      "_type": "request",
      "parentId": "fld_users",
      "name": "GET /users/{{ _.user_id }}  (manual)",
      "method": "GET",
      "url": "{{ _.base_url }}/users/{{ _.user_id }}",
      "headers": [],
      "description": "Fallback: paste an id into the 'user_id' environment variable and run this.",
      "metaSortKey": 5
    },

    {
      "_id": "req_err_no_token",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "POST /users  (no token) → 401",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"nobody@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"PATIENT\",\n  \"fullName\": \"Nobody\"\n}"
      },
      "metaSortKey": 1
    },
    {
      "_id": "req_err_non_admin",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "POST /users  (DOCTOR token, not ADMIN) → 403",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_doctor', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"someone@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"PATIENT\",\n  \"fullName\": \"Someone\"\n}"
      },
      "description": "Run '1 · auth → POST /auth/login (the registered doctor)' first so this has a non-admin token to send.",
      "metaSortKey": 2
    },
    {
      "_id": "req_err_dup_email",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "POST /users  (email already used) → 409",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_admin', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"doc@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"NURSE\",\n  \"fullName\": \"Duplicate\"\n}"
      },
      "description": "Same email as the registered doctor.",
      "metaSortKey": 3
    },
    {
      "_id": "req_err_validation",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "POST /users  (missing password) → 400",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_admin', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"x@hospital.local\",\n  \"role\": \"PATIENT\",\n  \"fullName\": \"X\"\n}"
      },
      "description": "Bean-validation failure → ProblemDetail 400.",
      "metaSortKey": 4
    },
    {
      "_id": "req_err_doctor_no_crm",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "POST /users  (DOCTOR without crm/specialty) → 400",
      "method": "POST",
      "url": "{{ _.base_url }}/users",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Authorization", "value": "Bearer {% response 'body', 'req_login_admin', 'b64::JC5hY2Nlc3NUb2tlbg==::46b', 'when-expired', 3000 %}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"baddoc@hospital.local\",\n  \"password\": \"secret12345\",\n  \"role\": \"DOCTOR\",\n  \"fullName\": \"Bad Doc\"\n}"
      },
      "description": "Domain invariant: a doctor must carry crm + specialty.",
      "metaSortKey": 5
    },
    {
      "_id": "req_err_get_unknown",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "GET /users/does-not-exist → 404",
      "method": "GET",
      "url": "{{ _.base_url }}/users/does-not-exist",
      "headers": [],
      "metaSortKey": 6
    },
    {
      "_id": "req_err_refresh_garbage",
      "_type": "request",
      "parentId": "fld_errors",
      "name": "POST /auth/refresh  (garbage token) → 401",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/refresh",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refreshToken\": \"not-a-real-token\"\n}"
      },
      "metaSortKey": 7
    }
  ]
}
